<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to post the evolved notifications (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Public launcher resolution only; no private WeChat components. -->
    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.google.android.projection.gearhead" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.WeChatNotifyEvo"
        android:enableOnBackInvokedCallback="true">

        <!-- Read-only, temporary sharing of one generated report. The path XML
             exposes cache/diagnostics only; no broad cache or files root. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.diagnostics"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/diagnostics_file_paths" />
        </provider>

        <!-- Official Android Auto notification-messaging capability. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Bubble trampoline: conversation-shortcut bubbles launch their
             shortcut intent from the system, so this stays exported (same
             as Nevolution's plugin launcher activity). Opaque: a
             transparent window may not count as foreground, and a black
             window hides which step failed. -->
        <activity
            android:name=".BubbleTrampolineActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar" />

        <!-- The system binds this service once notification access is granted.
             exported=true follows the working reference (QQ-Notify-Evolution). -->
        <service
            android:name=".WeChatListenerService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional, user-controlled process reliability aid. No existing FGS type
             describes keeping a NotificationListenerService process available, so
             specialUse is declared rather than misrepresenting it as dataSync. -->
        <service
            android:name=".OptionalKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-opted persistent notification to improve availability of the app's notification-listener service; no data transfer or sensitive notification processing occurs in this foreground service." />
        </service>

        <service
            android:name=".KeepAliveHealthJobService"
            android:exported="true"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <receiver
            android:name=".KeepAliveRestoreReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Receives reply / mark-read / delete actions from evolved notifications.
             Only ever targeted with explicit intents, so it stays non-exported. -->
        <receiver
            android:name=".EvolutionActionReceiver"
            android:exported="false" />

        <!-- WNE-only simulated Android Auto actions; explicit PendingIntents only. -->
        <receiver
            android:name=".AndroidAutoCompatActionReceiver"
            android:exported="false" />

    </application>

</manifest>
