<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Needed to post the evolved notifications (Android 13+ runtime permission). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The system binds this service once notification access is granted.
             exported=true follows the working reference (QQ-Notify-Evolution). -->
        <service
            android:name=".WeChatListenerService"
            android:exported="true"
            android:label="@string/service_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Receives reply / mark-read / delete actions from evolved notifications.
             Only ever targeted with explicit intents, so it stays non-exported. -->
        <receiver
            android:name=".EvolutionActionReceiver"
            android:exported="false" />

        <!-- Trampoline for system bubbles: bubble PendingIntents must be
             mutable, but WeChat's content intent is immutable, so the bubble
             points here (mutable, created by us) and this activity forwards
             to the original intent in the "target" extra. Translucent (not
             NoDisplay): the forward must happen from a visible window or the
             system may drop it. -->
        <activity
            android:name=".BubbleActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:exported="false"
            android:excludeFromRecents="true" />

    </application>

</manifest>
